{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "x402-mcp-chain-query",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "UPSTREAM_API_BASE": "https://x402-chain-query.marshy-shake.workers.dev",
    "PAY_TO": "0xc8aaea11c93a438e2fc7bd5cddb9a6936ed3595c",
    "FREE_TRIAL_N": "10",
    "FACILITATOR_URL": "https://facilitator.payai.network"
  },
  // No CDP secrets required (PayAI facilitator). Never commit secrets.
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChainQueryMCP",
        "name": "MCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChainQueryMCP"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "TRIAL_KV",
      "id": "7d385755c4f14c79b7e7da54bede573a",
      "preview_id": "fb3cbe3577ad46d4b81e1981b9595580"
    }
  ]
}
